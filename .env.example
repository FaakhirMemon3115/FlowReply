# FlowReply Environment Configuration
# Copy this file to backend/.env and update values as needed

# Database (SQLite - no external DB required for local dev)
# Prisma schema uses: file:./prisma/dev.db

# JWT secrets (change in production)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Server configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Redis (optional - for BullMQ background jobs)
REDIS_URL=redis://localhost:6379

# ─── Mock / Live Mode Flags ───
# Set to true for local sandbox (no external APIs needed)
USE_MOCK_WHATSAPP=true
USE_MOCK_ECOMMERCE=true
USE_MOCK_AI=true
USE_MOCK_BILLING=true

# ─── OpenAI (required when USE_MOCK_AI=false) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── WhatsApp Business Cloud API (required when USE_MOCK_WHATSAPP=false) ───
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v20.0
WA_WEBHOOK_VERIFY_TOKEN=flowreply_webhook_2026
