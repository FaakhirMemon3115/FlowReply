generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------- Platform & Identity ----------
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessMembers BusinessMember[]
  sessions        UserSession[]
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model Business {
  id        String            @id @default(uuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   BusinessMember[]
  settings  BusinessSettings?
  roles     Role[]
}

model BusinessSettings {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])
  // add settings fields as needed
}

model BusinessMember {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  roleId     String
  user       User     @relation(fields: [userId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id])
  permissions RolePermission[]
  members     BusinessMember[]
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ---------- Audit ----------
model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  payload    String?
  createdAt  DateTime @default(now())
}

// ---------- Notification ----------
model Notification {
  id         String    @id @default(uuid())
  businessId String
  userId     String?
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ---------- WhatsApp Conversations & Messages ----------
model Conversation {
  id               String    @id @default(uuid())
  waConversationId String?   @unique // WhatsApp conversation ID from Meta
  customerPhone    String // Customer WhatsApp number e.g. +923001234567
  customerName     String? // Display name from WhatsApp profile
  businessId       String?
  status           String    @default("open") // open | closed | handover
  language         String? // detected: en | roman_urdu | ur
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  waMessageId    String?      @unique // WhatsApp message ID from Meta
  direction      String // inbound | outbound
  type           String // text | audio | image | document
  content        String? // text content of message
  mediaUrl       String? // URL of media file (voice/image)
  transcription  String? // Whisper transcription if voice
  senderType     String // customer | bot | agent
  language       String? // detected language
  createdAt      DateTime     @default(now())
}
